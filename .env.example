NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=
MAYTAPI_PRODUCT_ID=
MAYTAPI_PHONE_ID=
MAYTAPI_API_TOKEN=
RESEND_API_KEY=
MAIL_FROM=

# Email over SMTP instead of Resend (AMEND-4). Set these and they win; leave
# them blank and Resend is used. SMTP_HOST/PORT default to Gmail (465, TLS).
# SMTP_PASSWORD is a 16-character Google App Password, never the account
# password — and App Passwords only exist once 2-Step Verification is on.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
CRON_SECRET=
DEFAULT_COUNTRY_CODE=+91
